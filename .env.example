# LLM（OpenAI 兼容，支持 reasoning 模型；可填 DeepSeek/Qwen/OpenAI 等）
RCA_OPENAI_API_KEY=
RCA_OPENAI_BASE_URL=https://api.openai.com/v1
RCA_MODEL=o3-mini
RCA_MAX_TOKENS=
RCA_REASONING_EFFORT=

# 运行参数
RCA_MAX_ITERATIONS=30
RCA_MAX_TOOL_OUTPUT=40000
RCA_MAX_DIFF_CHARS=30000
RCA_WORKSPACE=./workspace
RCA_REPORT_DIR=./reports

# 代码图谱（code-review-graph）
RCA_CRG_AUTOBUILD=1

# CodeGraph 索引（每分支 worktree + 独立索引，保证索引 == PR head commit SHA）
RCA_CODEGRAPH_ENABLED=1
RCA_CODEGRAPH_BINARY=codegraph
RCA_CODEGRAPH_INIT_TIMEOUT=3600
RCA_CODEGRAPH_SYNC_TIMEOUT=3600
RCA_CODEGRAPH_WT_MAX_COUNT=20

# Webhook / GitHub 评论
RCA_WEBHOOK_SECRET=
RCA_GITHUB_TOKEN=
RCA_SERVER_HOST=0.0.0.0
RCA_SERVER_PORT=8000
